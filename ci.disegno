; Disegno's CI, written in Disegno: the test suite in a container, run by Dagger.
; In CI the report has one line per item (chez, test); the tests' output is in the test group,
; and also stays in ci-out/test.log.
;
;   disegno run ci.disegno

(import dagger)

(claim chez Container)                                    ; Chez Scheme on Alpine, called scheme
(define chez
  (pipe (container)
        (from "alpine:3.22")
        (with-exec (list "apk" "add" "--no-cache" "chez-scheme"))
        (with-exec (list "ln" "-s" "/usr/bin/chez" "/usr/bin/scheme"))))

(claim test (→ Dir Dir))
(define (test repo)
  (pipe chez
        (with-dir /src repo)
        (with-workdir /src)
        (with-exec (list "sh" "-c" "mkdir -p /out; scheme --script tests/test.ss >/out/test.log 2>&1; s=$?; cat /out/test.log; exit $s"))
        (dir-of /out)))

(claim main (Π ((repo (Host "."))) (Export Dir)))
(define (main repo) (overlay "ci-out" (test repo)))
