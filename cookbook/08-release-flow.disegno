; 08 — Un rilascio in sequenza: test, staging, controllo, prod
;
; Le uscite del piano si realizzano in ordine con then: un deploy è un effetto (apply), fuori
; dalla cache, e un controllo sul mondo (probe) si fa quando lo si raggiunge, dopo lo staging.
; Il deploy qui è un echo in un container, per non toccare niente di vero.
;
; I teoremi dicono che il test viene prima di ogni deploy e che prod viene dopo staging: è una
; verità sulla forma del piano. Che il test abbia risposto sì è la verità di quel test, in quel
; momento, non del mondo: guida il ramo e non diventa un assioma.
;
;   disegno plan cookbook/08-release-flow.disegno     una sequenza di uscite per ogni esito
;   disegno run  cookbook/08-release-flow.disegno

(import dagger)

(def strumenti : Container
  (pipe (container) (from "busybox@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e")))

(def deploy : (→ String (Export Dir))
  [env] (apply strumenti ["echo" "deploy" env]))

; Il test guarda il sorgente; il controllo sullo staging guarda il mondo, dopo il deploy.
(def test : (→ Dir (Remote Bool))
  [src] (passes? (try-exec (pipe strumenti (with-dir /src src)) ["test" "-f" "/src/go.mod"])))

(def staging-risponde : (Remote Bool)
  (probe strumenti ["true"]))

(def rilascio : (→ Dir (Export Dir))
  [src] (branch (test src)
          (then (deploy "staging")
                (branch staging-risponde
                  (deploy "prod")
                  skip))
          (overlay "out" (with-file empty /RIFIUTATO "il test non è passato\n"))))

(def main : (→ [src (Host "hello")] (Export Dir))
  [src] (rilascio src))

; --- l'ordine, per ogni sorgente ---

; Il deploy verso un ambiente: un apply il cui comando nomina l'ambiente.
(def names? : (→ String Arg Bool)
  [env (arg-text s)] (not (distinct? env s))
  [env (arg-path _)] false)

(def targets? : (→ String (Export Dir) Bool)
  [env (apply _ args)] (any? (names? env) args)
  [env _]              false)

(def test-prima-del-deploy : (→ [src Dir] (Before test? apply? (rilascio src)))
  [src] auto)

(def prod-dopo-staging : (→ [src Dir] (Precedes (targets? "staging") (targets? "prod") (rilascio src)))
  [src] auto)

; E il contrario: un deploy in prod da solo non rispetta l'ordine.
(def prod-diretto : (¬ (Precedes (targets? "staging") (targets? "prod") (deploy "prod")))
  auto)
