; 04 — I punti non si sommano: letterali tipati e spazi affini
;
; Si scrivono ancora stringhe e numeri familiari, ma è il tipo atteso a leggerli: un letterale
; malformato è un errore di tipo, non un fallimento dentro un container. Dove ci sono posizioni
; e spostamenti valgono le regole affini: punto + spostamento = punto, punto − punto =
; spostamento (solo se ha senso), punto + punto non si scrive.
;
;   disegno check cookbook/04-literals.disegno

; --- immagini: un tag è un punto mobile, un digest un punto fisso ---

(import dagger time)

(def builder : Image "golang:1.25-alpine")
(def base    : Image "alpine@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1")

(def base-fissata : (So (pinned? base))
  auto)

; --- percorsi: /out è un punto, "bin/hello" uno spostamento ---

(def out : Abs /out)
(def bin : Abs (⊕ out "bin/hello"))

(def bin-dentro-out : (⊑ bin out)
  auto)

(def da-out-a-bin : (≡ (⊖ bin out auto) "bin/hello")     ; la differenza vuole la prova (⊑ bin out)
  auto)

; --- tempo: istanti e durate ---

(def avvio    : Instant "2026-10-15T09:00:00Z")
(def scadenza : Instant (⊕ avvio "36h"))

(def un-giorno-e-mezzo : (≡ (⊖ scadenza avvio auto) "1d12h")
  auto)

; --- indirizzi e porte ---

(def rete : Cidr "10.0.0.0/16")
(def gw   : Ip "10.0.0.1")
(def web  : Port 8080)

(def gw-nella-rete : (So (in? gw rete))
  auto)

; --- errori di tipo: togli il ; davanti a una riga per vederli ---
; (def e1 : Image "Golang:1.25")              ; «Golang:1.25» non è un Image valido
; (def e2 : Abs (⊕ out /bin))                 ; punto + punto: atteso Rel, trovato Abs
; (def e3 : Rel (⊖ out bin auto))             ; /out non sta dentro /out/bin/hello: nessuna prova
; (def e4 : Instant (⊕ avvio scadenza))       ; atteso Duration, trovato Instant
; (def e5 : Cidr "10.0.0.1/24")               ; blocco non allineato: non è un Cidr valido
; (def e6 : Port 70000)                       ; «70000» non è un Port valido
