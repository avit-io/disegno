; I file: directory costruite come valori, che cosa scrivono, e osservazioni sul contenuto.
; Il contenuto di un file non torna mai al linguaggio: lo guarda Dagger, in un container, e il
; programma riceve un'osservazione (Remote Bool) da usare con branch, come per passes?.

(import dagger)

; --- costruire ---

; Un file con il suo nome: il nome è un Segment, quindi "a/b" o "" non passano.
(def file : (→ Segment String File)
  [n contents] (Query.file (Segment.name n) contents))

(def file-of : (→ Dir Abs File)
  [d path] (Directory.file d path))

(def put-file : (→ Dir Abs File Dir)
  [d path f] (Directory.with-file d path f))

(def merge : (→ Dir Dir Dir)                   ; b sopra a, dalla radice
  [a b] (Directory.with-directory a root b))

; --- che cosa scrive una directory: i percorsi lungo la sua catena di costruzione ---
; Come i montaggi di un container, si guarda solo la catena (chain), che non scende negli
; argomenti: le proprietà valgono per ogni sorgente.

(def write-of : (→ Any (List Abs))
  [(any (Directory.with-new-file _ path _))]      [path]
  [(any (Directory.with-file _ path _))]          [path]
  [(any (Directory.with-directory _ path _))]     [path]
  [(any (Directory.with-new-directory _ path))]   [path]
  [_]                                             [])

(def writes : (→ (Obj k) (List Abs))
  [p] (concat-map write-of (chain p)))

; Nessuna scrittura ne copre un'altra: né lo stesso percorso due volte, né uno dentro l'altro.
(def Disjoint-writes : (→ (Obj k) Type)
  [p] (Pairwise ⋔ (writes p)))

; Tutto ciò che si scrive sta sotto r.
(def Writes-within : (→ Abs (Obj k) Type)
  [r p] (Every (λ [q] (⊑ q r)) (writes p)))

; --- osservazioni sul contenuto, calcolate da Dagger ---
; Il testo arriva al comando come argomento, non passa da una shell. Sono osservazioni di
; passes?, quindi per Before contano come test.
; ponytail: un'espressione regolare malformata fa uscire grep con 2, cioè «falso»; un tipo
; Regex raffinato la rifiuterebbe prima, se servirà.

(def strumenti : Container
  (pipe (container) (from "busybox@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e")))

(def guarda : (→ File (List Arg) (Remote Bool))
  [f cmd] (passes? (pipe strumenti (Container.with-file /f f) (try-exec cmd))))

(def includes? : (→ File String (Remote Bool))  ; il testo compare nel file
  [f s] (guarda f ["grep" "-qF" s "/f"]))

(def matches? : (→ File String (Remote Bool))   ; una riga soddisfa l'espressione regolare estesa
  [f re] (guarda f ["grep" "-qE" re "/f"]))

(def empty? : (→ File (Remote Bool))            ; il file è vuoto
  [f] (guarda f ["sh" "-c" "! test -s /f"]))

(def same-content? : (→ File File (Remote Bool))
  [a b] (passes? (pipe strumenti (Container.with-file /a a) (Container.with-file /b b)
                       (try-exec ["cmp" "-s" "/a" "/b"]))))
