(import text affine)

; --- I punti non si sommano: il file system come spazio affine ---
; Un punto è la radice più dei passi: /out è (/ root "out"). Un vettore è una sequenza di passi:
; "bin/hello". Punto ⊕ vettore = punto; punto ⊖ punto = vettore, solo se uno contiene l'altro;
; punto + punto non si può nemmeno scrivere: / vuole un Segment.
; Senza .. i vettori sono un monoide, non un gruppo: per questo la differenza è parziale.

(extern segment? : (→ String Bool) %segment?)

(record Segment
  (name String)
  (ok (So (segment? name))))
(builtin segment Segment)

(data Abs
  (root)
  (/ Abs Segment))
(builtin abs Abs)
(builtin root root)
(builtin slash /)

(data Rel
  (here)
  (step Rel Segment))
(builtin rel Rel)
(builtin here here)
(builtin step step)

; (⊑ p q): p sta dentro q. È induttivo, quindi la differenza si calcola sulla prova e le leggi
; si dimostrano per induzione, senza confrontare stringhe.
(data ⊑ : (→ Abs Abs Type)
  (⊑-refl : (⊑ p p))
  (⊑-step : (→ (⊑ p q) (⊑ (/ p s) q))))

(claim Abs.⊕ (→ Abs Rel Abs))
(define (Abs.⊕ p n)
  (match n
    (here       p)
    ((step v s) (/ (⊕ p v) s))))

(claim Abs.⊖ (Π ((p Abs) (q Abs)) (→ (⊑ p q) Rel)))
(define (Abs.⊖ p q n)
  (match* (p n)
    ((p ⊑-refl)     here)
    (((/ p s) (⊑-step h)) (step (⊖ p q h) s))))

(claim /s (→ Segment Abs Abs))
(define (/s s p) (/ p s))

; Un punto come testo, per comporre indirizzi: /site/css → "/site/css"; la radice è "".
(claim render-abs (→ Abs String))
(define (render-abs n)
  (match n
    (root    "")
    ((/ p s) (string-append (render-abs p) "/" (Segment.name s)))))

; La legge: q ⊕ (p ⊖ q) = p. Dimostrata qui una volta; chi scrive un disegno la eredita.
(claim ⊕-⊖ (Π ((p Abs) (q Abs) (h (⊑ p q))) (≡ (⊕ q (⊖ p q h)) p)))
(define (⊕-⊖ p q h)
  (match* (p h)
    ((p ⊑-refl)     refl)
    (((/ p s) (⊑-step h)) (cong (/s s) (⊕-⊖ p q h)))))

(claim percorsi (Affine Abs Rel ⊑))
(define percorsi (affine Abs.⊕ Abs.⊖ ⊕-⊖))

; Regioni: il sottoalbero di un punto. (⋔ p q): i sottoalberi di p e q sono disgiunti, perché i
; due percorsi si separano a un passo. Induttivo come ⊑; auto trova il punto di separazione.

(claim ≠ (→ Segment Segment Type))
(define (≠ s t) (So (distinct? (Segment.name s) (Segment.name t))))

(data ⋔ : (→ Abs Abs Type)
  (⋔-here  : (→ (≠ s t) (⋔ (/ p s) (/ p t))))
  (⋔-left  : (→ (⋔ p q) (⋔ (/ p s) q)))
  (⋔-right : (→ (⋔ p q) (⋔ p (/ q s)))))
