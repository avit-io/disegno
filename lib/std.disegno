; Libreria standard: l'unico posto dove extern e include sono ammessi.

; --- uguaglianza ---

(data ≡ : (→ A A Type)
  [refl : (≡ x x)])

(def cong : (→ [f (→ A B)] (≡ x y) (≡ (f x) (f y)))
  [f refl] refl)

(def sym : (→ (≡ x y) (≡ y x))
  [refl] refl)

; --- proposizioni decidibili: (So b) è ⊤ se b è vero, ⊥ altrimenti; auto prova ⊤ calcolando ---

(data ⊥ : Type)

(data ⊤
  [tt])

(data Bool
  [true]
  [false])

(def ¬ : (→ Type Type)              ; negazione: (¬ A) è A → ⊥
  [A] (→ A ⊥))

(def So : (→ Bool Type)
  [true]  ⊤
  [false] ⊥)

(def if : (→ Bool A A A)
  [true  a _] a
  [false _ b] b)

; --- naturali: 0, 1, 2… sono zucchero per zero, add1 ---

(data Nat
  [zero]
  [add1 Nat])

(def + : (→ Nat Nat Nat)
  [zero     m] m
  [(add1 k) m] (add1 (+ k m)))

(def ≤? : (→ Nat Nat Bool)
  [zero     _]        true
  [(add1 _) zero]     false
  [(add1 m) (add1 n)] (≤? m n))

(def ≥ : (→ Nat Nat Type)
  [m n] (So (≤? n m)))

; Le definizioni sono unarie e sono la verità logica; il valutatore calcola +, ∸, *, ≤?, <?,
; nat=? e pow2 nativamente sui numeri (types.ss, fast), e test.ss verifica che coincidano.

(def ∸ : (→ Nat Nat Nat)                 ; sottrazione troncata
  [p        zero]     p
  [zero     (add1 _)] zero
  [(add1 p) (add1 q)] (∸ p q))

(def * : (→ Nat Nat Nat)
  [zero     _] zero
  [(add1 k) m] (+ m (* k m)))

(def <? : (→ Nat Nat Bool)
  [m n] (≤? (add1 m) n))

(def nat=? : (→ Nat Nat Bool)
  [zero     zero]     true
  [zero     (add1 _)] false
  [(add1 _) zero]     false
  [(add1 m) (add1 n)] (nat=? m n))

(def pow2 : (→ Nat Nat)
  [zero]     1
  [(add1 k)] (+ (pow2 k) (pow2 k)))

(def not : (→ Bool Bool)
  [true]  false
  [false] true)

(def and : (→ Bool Bool Bool)
  [true  b] b
  [false _] false)

(def or : (→ Bool Bool Bool)
  [true  _] true
  [false b] b)

; L'ordine come relazione induttiva: la differenza si calcola sulla prova, come per i percorsi.
(data ≤ : (→ Nat Nat Type)
  [≤-zero : (≤ zero n)]
  [≤-succ : (→ (≤ m n) (≤ (add1 m) (add1 n)))])

; Riflessione: dal test booleano alla relazione induttiva.
(def ≤-from : (→ [m Nat] [n Nat] (So (≤? m n)) (≤ m n))
  [zero     n        _] ≤-zero
  [(add1 m) (add1 n) h] (≤-succ (≤-from m n h)))

; La legge dei naturali: q + (p ∸ q) = p se q ≤ p. Serve al tempo e agli indirizzi.
(def +-∸ : (→ [p Nat] [q Nat] [h (≤ q p)] (≡ (+ q (∸ p q)) p))
  [p        zero     ≤-zero]     refl
  [(add1 p) (add1 q) (≤-succ h)] (cong add1 (+-∸ p q h)))

; --- liste: ["a" "b"] è zucchero per (:: "a" (:: "b" vuota)) ---

(data List : (→ Type Type)
  [vuota : (List A)]
  [::    : (→ A (List A) (List A))])

(def ++ : (→ (List A) (List A) (List A))
  [vuota    ys] ys
  [(:: x xs) ys] (:: x (++ xs ys)))

(def concat-map : (→ (→ A (List B)) (List A) (List B))
  [f vuota]     []
  [f (:: x xs)] (++ (f x) (concat-map f xs)))

(def any? : (→ (→ A Bool) (List A) Bool)
  [p vuota]     false
  [p (:: x xs)] (if (p x) true (any? p xs)))

(def all : (→ (→ A Bool) (List A) Bool)
  [p vuota]     true
  [p (:: x xs)] (if (p x) (all p xs) false))

(def map : (→ (→ A B) (List A) (List B))
  [f vuota]     []
  [f (:: x xs)] (:: (f x) (map f xs)))

(def All : (→ (→ A Bool) (List A) Type)
  [p xs] (So (all p xs)))

; Proposizioni su liste: Every p xs (ogni elemento soddisfa p), Pairwise r xs (ogni coppia è in r).

(data × : (→ Type Type Type)
  [pair : (→ A B (× A B))])

(def Every : (→ (→ A Type) (List A) Type)
  [p vuota]     ⊤
  [p (:: x xs)] (× (p x) (Every p xs)))

(def Pairwise : (→ (→ A A Type) (List A) Type)
  [r vuota]     ⊤
  [r (:: x xs)] (× (Every (r x) xs) (Pairwise r xs)))

; --- stringhe: opache, ma con primitive pure calcolate sui letterali ---

(extern String    : Type String)
(extern contains? : (→ String String Bool) %contains?)
(extern concat    : (→ String String String) %concat)
(extern show      : (→ Nat String) %show)
(extern show-ip   : (→ Nat String) %show-ip)

(extern image-ref? : (→ String Bool)        %image-ref?)
(extern segment?   : (→ String Bool)        %segment?)
(extern distinct?  : (→ String String Bool) %distinct?)

; --- valori raffinati: il letterale resta, il tipo cambia ---
; Un record (valore, prova) accoglie un letterale: "golang:1.25-alpine" atteso come Image diventa
; (image "golang:1.25-alpine" auto). Se è malformato è un errore di tipo, non del container.

(record Image
  [raw : String]
  [ok  : (So (image-ref? raw))])

(record Segment
  [name : String]
  [ok   : (So (segment? name))])

; --- I punti non si sommano: il file system come spazio affine ---
; Un punto è la radice più dei passi: /out è (/ root "out"). Un vettore è una sequenza di passi:
; "bin/hello". Punto ⊕ vettore = punto; punto ⊖ punto = vettore, solo se uno contiene l'altro;
; punto + punto non si può nemmeno scrivere: / vuole un Segment.
; Senza .. i vettori sono un monoide, non un gruppo: per questo la differenza è parziale.

(data Abs
  [root]
  [/ Abs Segment])

(data Rel
  [here]
  [step Rel Segment])

; (⊑ p q): p sta dentro q. È induttivo, quindi la differenza si calcola sulla prova e le leggi
; si dimostrano per induzione, senza confrontare stringhe.
(data ⊑ : (→ Abs Abs Type)
  [⊑-refl : (⊑ p p)]
  [⊑-step : (→ (⊑ p q) (⊑ (/ p s) q))])

(def Abs.⊕ : (→ Abs Rel Abs)
  [p here]       p
  [p (step v s)] (/ (⊕ p v) s))

(def Abs.⊖ : (→ [p Abs] [q Abs] (⊑ p q) Rel)
  [p       q ⊑-refl]     here
  [(/ p s) q (⊑-step h)] (step (⊖ p q h) s))

(def /s : (→ Segment Abs Abs)
  [s p] (/ p s))

; La legge: q ⊕ (p ⊖ q) = p. Dimostrata qui una volta; chi scrive un disegno la eredita.
(def ⊕-⊖ : (→ [p Abs] [q Abs] [h (⊑ p q)] (≡ (⊕ q (⊖ p q h)) p))
  [p       q ⊑-refl]     refl
  [(/ p s) q (⊑-step h)] (cong (/s s) (⊕-⊖ p q h)))

; Uno spazio affine: punti P, spostamenti V, una relazione ≤ che dice quando la differenza esiste.
(record (Affine P V [≤ (→ P P Type)])
  [+   : (→ P V P)]
  [-   : (→ [p P] [q P] (≤ p q) V)]
  [law : (→ [p P] [q P] [h (≤ p q)] (≡ (+ q (- p q h)) p))])

(def percorsi : (Affine Abs Rel ⊑)
  (affine Abs.⊕ Abs.⊖ ⊕-⊖))

; Regioni: il sottoalbero di un punto. (⋔ p q): i sottoalberi di p e q sono disgiunti, perché i
; due percorsi si separano a un passo. Induttivo come ⊑; auto trova il punto di separazione.

(def ≠ : (→ Segment Segment Type)
  [s t] (So (distinct? (Segment.name s) (Segment.name t))))

(data ⋔ : (→ Abs Abs Type)
  [⋔-here  : (→ (≠ s t) (⋔ (/ p s) (/ p t)))]
  [⋔-left  : (→ (⋔ p q) (⋔ (/ p s) q))]
  [⋔-right : (→ (⋔ p q) (⋔ p (/ q s)))])

; --- naturali: l'istanza da cui discendono tempo e indirizzi ---

(def ≥N : (→ Nat Nat Type)                ; (≥N p q): la differenza p ∸ q è esatta
  [p q] (≤ q p))

(def Nat.⊖ : (→ [p Nat] [q Nat] (≥N p q) Nat)
  [p q _] (∸ p q))

(def naturali : (Affine Nat Nat ≥N)
  (affine + Nat.⊖ +-∸))

; --- regioni su una retta: intervalli semiaperti [lo, hi) ---
; Le finestre di tempo, i blocchi CIDR e gli intervalli di porte sono intervalli; le proposizioni
; naturali sono il contenimento e la disgiunzione.

(record Interval
  [lo : Nat]
  [hi : Nat])

(def apart? : (→ Interval Interval Bool)
  [a b] (or (≤? (Interval.hi a) (Interval.lo b)) (≤? (Interval.hi b) (Interval.lo a))))

(def Apart : (→ Interval Interval Type)
  [a b] (So (apart? a b)))

(def within? : (→ Interval Interval Bool)  ; a sta dentro b
  [a b] (and (≤? (Interval.lo b) (Interval.lo a)) (≤? (Interval.hi a) (Interval.hi b))))

(def Within : (→ Interval Interval Type)
  [a b] (So (within? a b)))

; --- tempo: istanti e durate, in secondi. "2026-10-15T10:00:00Z" è un istante, "1h30m" una durata ---

(data Instant
  [at Nat])

(data Duration
  [secs Nat])

(def Instant.⊕ : (→ Instant Duration Instant)
  [(at a) (secs d)] (at (+ a d)))

; Sugli istanti (miliardi di secondi) l'ordine è il test decidibile, che auto calcola; la legge
; passa per la relazione induttiva con il lemma di riflessione ≤-from.
(def ≥t : (→ Instant Instant Type)        ; (≥t p q): p non viene prima di q
  [(at p) (at q)] (So (≤? q p)))

(def Instant.⊖ : (→ [p Instant] [q Instant] (≥t p q) Duration)
  [(at a) (at b) _] (secs (∸ a b)))

(def Instant.⊕-⊖ : (→ [p Instant] [q Instant] [h (≥t p q)] (≡ (Instant.⊕ q (Instant.⊖ p q h)) p))
  [(at a) (at b) h] (cong at (+-∸ a b (≤-from b a h))))

(def tempo : (Affine Instant Duration ≥t)
  (affine Instant.⊕ Instant.⊖ Instant.⊕-⊖))

(def window : (→ Instant Duration Interval) ; una finestra: dall'istante, per la durata
  [(at a) (secs d)] (interval a (+ a d)))

; --- indirizzi IPv4: punti in [0, 2³²). "10.0.0.5" è un Ip, "10.0.0.0/24" un blocco Cidr ---
; Il gruppo vero è modulo 2³²; Disegno esclude l'overflow: Ip.⊕ chiede la prova che si resti
; nello spazio, quindi non è il + totale del record Affine.

(record Ip
  [n  : Nat]
  [ok : (So (<? n 4294967296))])

(def Ip.⊕ : (→ [p Ip] [o Nat] (So (<? (+ (Ip.n p) o) 4294967296)) Ip)
  [p o h] (ip (+ (Ip.n p) o) h))

(record Cidr                               ; il blocco prefisso·2^(32−len) … di lunghezza 2^(32−len)
  [prefix : Nat]
  [len    : Nat]
  [ok     : (So (and (≤? len 32) (<? prefix (pow2 len))))])

(def cidr-range : (→ Cidr Interval)
  [c] (let [size (pow2 (∸ 32 (Cidr.len c))), lo (* (Cidr.prefix c) size)]
        (interval lo (+ lo size))))

(def render-ip : (→ Ip String)
  [a] (show-ip (Ip.n a)))

(def render-cidr : (→ Cidr String)
  [c] (concat (show-ip (Interval.lo (cidr-range c))) (concat "/" (show (Cidr.len c)))))

(def in? : (→ Ip Cidr Bool)
  [a c] (within? (interval (Ip.n a) (add1 (Ip.n a))) (cidr-range c)))

(def Disjoint-subnets : (→ (List Cidr) Type)
  [cs] (Pairwise Apart (map cidr-range cs)))

; --- porte: punti su [0, 65535], senza spostamenti; le regioni sono intervalli ---

(record Port
  [n  : Nat]
  [ok : (So (≤? n 65535))])

(def port-range : (→ Port Port Interval)  ; [a, b] come intervallo semiaperto
  [a b] (interval (Port.n a) (add1 (Port.n b))))

(def port≠ : (→ Port Port Type)
  [a b] (So (not (nat=? (Port.n a) (Port.n b)))))

; La riga di comando resta lo scalpello: si tipano i valori che vi si interpolano, non la sintassi.

(data Arg
  [arg-text String]
  [arg-path Abs])

; --- il piano è un dato: Kind, Obj, gli alias Container, Directory… e nodes, generati (gen.ss) ---

(include "engine.disegno")

; Due tempi, due condizionali: if (sopra) decide su valori noti quando si costruisce il piano;
; branch su osservazioni, che esistono solo durante l'esecuzione. Un (Remote Bool) non è un Bool.
; ponytail: l'argomento di Remote ed Export è documentazione; esistono solo osservazioni booleane
; ed export di directory. Servirà un Kind indicizzato quando ce ne saranno altri.

(def Remote : (→ Type Type)
  [_] (Obj Kind.bool))

(def Export : (→ Type Type)
  [_] (Obj Kind.export))

; Confine con l'host: l'utente legge l'host solo tramite (Host "percorso") nella firma di main.

(def Host : (→ String Type)
  [_] Directory)

; --- nomi corti: file system del motore, valori immutabili; scrivere è costruire una nuova directory ---

(def Dir : Type
  Directory)

(def empty : Dir
  Query.directory)

(def with-file : (→ Dir Abs String Dir)
  [d path contents] (Directory.with-new-file d path contents))

(def without : (→ Dir Abs Dir)
  [d path] (Directory.without-file d path))

(def sub : (→ Dir Abs Dir)
  [d path] (Directory.directory d path))

(def put : (→ Dir Abs Dir Dir)
  [d path source] (Directory.with-directory d path source))

(def exists? : (→ Dir Abs (Remote Bool))
  [d path] (Directory.exists d path))

; --- container: with-exec dichiara un comando, non lo esegue ---
; I campi dello schema si scrivono senza prefisso: (from c "alpine") è Container.from perché c è
; un Container, (container) è il campo radice Query.container. Qui solo i nomi curati.

(def with-dir : (→ Container Abs Dir Container)
  [c path source] (Container.with-directory c path source))

(def with-env : (→ Container String String Container)
  [c name value] (Container.with-env-variable c name value))

(def dir-of : (→ Container Abs Dir)
  [c path] (Container.directory c path))

; --- proprietà del piano: si calcolano sul dato ---

(def image-of : (→ Any (List Image))
  [(any (Container.from _ address))] [address]
  [_]                                [])

(def images : (→ (Obj k) (List Image))
  [p] (concat-map image-of (nodes p)))

; Un'immagine con tag è un punto mobile, una con digest un punto fisso: pinned vuol dire fissa.
(def pinned? : (→ Image Bool)
  [i] (contains? (Image.raw i) "@sha256:"))

; Proprietà d'ordine. Le uscite del piano (export, publish) si scelgono con branch: effects le
; elenca, ciascuna con le osservazioni che devono essere vere perché avvenga. Non scende nelle
; directory, quindi vale anche per un input astratto: (→ [src Dir] (Before … (release src))).

(data Effect
  [effect (List (Remote Bool)) (Export Dir)])

(def effects : (→ (List (Remote Bool)) (Export Dir) (List Effect))
  [gs (branch c a b)] (++ (effects (:: c gs) a) (effects gs b))
  [gs e]              [(effect gs e)])

(def guarded? : (→ (→ (Remote Bool) Bool) (→ (Export Dir) Bool) Effect Bool)
  [t? e? (effect gs x)] (if (e? x) (any? t? gs) true))

; (Before t? e? p): ogni uscita che soddisfa e? avviene solo se un'osservazione che soddisfa t? è vera.
(def Before : (→ (→ (Remote Bool) Bool) (→ (Export Dir) Bool) (Export Dir) Type)
  [t? e? p] (So (all (guarded? t? e?) (effects vuota p))))

(def test? : (→ (Remote Bool) Bool)
  [(passes? _)] true
  [_]           false)

(def publish? : (→ (Export Dir) Bool)
  [(publish _ _)] true
  [_]             false)

; Montaggi lungo la catena di un container: dove vengono collocati directory, file e cache.
; Due container diversi non si contendono il file system, quindi si guarda solo la catena (chain),
; che non scende negli argomenti: la proprietà vale per ogni sorgente.

(def mount-of : (→ Any (List Abs))
  [(any (Container.with-directory _ path _))]         [path]
  [(any (Container.with-file _ path _))]              [path]
  [(any (Container.with-mounted-directory _ path _))] [path]
  [(any (Container.with-mounted-file _ path _))]      [path]
  [(any (Container.with-mounted-cache _ path _))]     [path]
  [_]                                                 [])

(def mounts : (→ (Obj k) (List Abs))
  [p] (concat-map mount-of (chain p)))

(def Disjoint-mounts : (→ (Obj k) Type)
  [p] (Pairwise ⋔ (mounts p)))

; Porte esposte lungo la catena di un container: nessuna porta allocata due volte.

(def port-of : (→ Any (List Port))
  [(any (Container.with-exposed-port _ p))] [p]
  [_]                                       [])

(def ports : (→ (Obj k) (List Port))
  [p] (concat-map port-of (chain p)))

(def Distinct-ports : (→ (Obj k) Type)
  [p] (Pairwise port≠ (ports p)))
