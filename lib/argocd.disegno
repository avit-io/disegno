; ArgoCD: sincronizzare un'applicazione e aspettare che sia sana. Il server può essere in chiaro o
; in un segreto (Setting); ci si autentica con un token o con utente e password, tutti segreti.
; Sincronizzare è un effetto; «l'applicazione è sana?» è un'osservazione, la verità di quel momento.

(import dagger delivery)

(data Argocd-auth
  [token Secret]
  [user-password Secret Secret])

(record Argocd
  [server   : Setting]                     ; argocd.example.com, senza https://
  [auth     : Argocd-auth]
  [insecure : Bool])                       ; true: non verifica il certificato del server

(def with-argocd-auth : (→ Container Argocd-auth Container)
  [c (token t)]           (with-secret-variable c "ARGOCD_AUTH_TOKEN" t)
  [c (user-password u p)] (pipe c (with-secret-variable "ARGOCD_USERNAME" u) (with-secret-variable "ARGOCD_PASSWORD" p)))

(def argocd-cli : (→ Argocd Container)
  [ac] (pipe (container)
             (from "quay.io/argoproj/argocd@sha256:19ba7f44cba487c4a0c98ac336327c4df04383dff84f87ea1a578972eb62dd17")   ; v3.1.8
             (with-setting "ARGOCD_SERVER" (Argocd.server ac))
             (with-argocd-auth (Argocd.auth ac))
             (with-env "ARGOCD_OPTS" (if (Argocd.insecure ac) "--grpc-web --insecure" "--grpc-web"))))

; Un comando della CLI: con utente e password si fa prima il login, nello stesso container.
(def argocd-script : String
  "if [ -n \"$ARGOCD_USERNAME\" ]; then argocd login \"$ARGOCD_SERVER\" --username \"$ARGOCD_USERNAME\" --password \"$ARGOCD_PASSWORD\" >/dev/null; fi; exec argocd \"$@\"")

(def argocd-args : (→ (List String) (List Arg))
  [xs] (++ ["sh" "-c" argocd-script "argocd"] (map arg-text xs)))

; La sync parte in modo asincrono, con i suoi tentativi; poi si aspetta la salute (argocd-wait).
(def argocd-sync : (→ Argocd String (Export Dir))
  [ac app] (apply (argocd-cli ac) (argocd-args ["app" "sync" app "--async" "--retry-limit" "5" "--retry-backoff-duration" "30s"
                                                "--retry-backoff-factor" "2" "--timeout" "150"])))

; Aspetta che l'applicazione sia sana, fino a timeout secondi; se non lo diventa, fallisce.
(def argocd-wait : (→ Argocd String Nat (Export Dir))
  [ac app timeout] (apply (argocd-cli ac) (argocd-args ["app" "wait" app "--health" "--timeout" (show timeout)])))

(def argocd-healthy? : (→ Argocd String (Remote Bool))
  [ac app] (probe (argocd-cli ac) (argocd-args ["app" "wait" app "--health" "--timeout" "30"])))

(def argocd-restart : (→ Argocd String String (Export Dir))   ; app, tipo di risorsa (Deployment, StatefulSet)
  [ac app kind] (apply (argocd-cli ac) (argocd-args ["app" "actions" "run" app "restart" "--kind" kind])))

(def argocd-command? : (→ String (Export Dir) Bool)   ; (argocd-command? "sync"): per Before e Precedes
  [op (apply _ (:: _ (:: _ (:: _ (:: (arg-text a) (:: (arg-text b) (:: (arg-text c) _)))))))]
    (and (same? a "argocd") (and (same? b "app") (same? c op)))
  [op _] false)

; ArgoCD come Deployer (delivery): deploy sincronizza e aspetta che l'applicazione sia sana;
; restart riavvia i Deployment dell'applicazione.
(def argocd-deployer : (→ Argocd Nat Deployer)          ; timeout in secondi
  [ac timeout] (deployer (λ [app] (then (argocd-sync ac app) (argocd-wait ac app timeout)))
                         (argocd-healthy? ac)
                         (λ [app] (argocd-restart ac app "Deployment"))))
