; Dagger: il piano come dato, i nomi corti e le proprietà del piano.

(import text paths net)

(extern image-ref? : (→ String Bool) %image-ref?)

; --- valori raffinati: il letterale resta, il tipo cambia ---
; Un record (valore, prova) accoglie un letterale: "golang:1.25-alpine" atteso come Image diventa
; (image "golang:1.25-alpine" auto). Se è malformato è un errore di tipo, non del container.

(record Image
  (raw String)
  (ok (So (image-ref? raw))))

; La riga di comando resta lo scalpello: si tipano i valori che vi si interpolano, non la sintassi.

(data Arg
  (arg-text String)
  (arg-path Abs))

; --- il piano è un dato: Kind, Obj, gli alias Container, Directory… e nodes, generati (gen.ss) ---

(import engine)                            ; generato: usa Arg, Image, Abs, Port

; Due tempi, due condizionali: if (nel prelude) decide su valori noti quando si costruisce il piano;
; branch su osservazioni, che esistono solo durante l'esecuzione. Un (Remote Bool) non è un Bool.
; ponytail: l'argomento di Remote ed Export è documentazione; esistono solo osservazioni booleane
; ed export di directory. Servirà un Kind indicizzato quando ce ne saranno altri.

(claim Remote (→ Type Type))
(define (Remote _) (Obj Kind.bool))

(claim Export (→ Type Type))
(define (Export _) (Obj Kind.export))

; Confine con l'host: l'utente legge l'host solo tramite (Host "percorso") nella firma di main.

(claim Host (→ String Type))
(define (Host _) Directory)
(builtin host Host)

; Un segreto dall'host: (Host-secret "AWS_ACCESS_KEY_ID") nella firma di main, letto da una
; variabile d'ambiente. Il valore non torna mai al linguaggio e non compare nel piano: si passa ai
; container con with-secret-variable o with-mounted-secret.
(claim Host-secret (→ String Type))
(define (Host-secret _) Secret)
(builtin host-secret Host-secret)

; Un parametro del piano: (Host-env "TAG" "") nella firma di main, letto dall'ambiente quando si
; costruisce il piano, con un valore di default. È un input, non un'osservazione: il piano è una
; funzione dei parametri, e i teoremi valgono per ogni valore.
(claim Host-env (→ String String Type))
(define (Host-env _ _) String)
(builtin host-env Host-env)

; --- nomi corti: file system del motore, valori immutabili; scrivere è costruire una nuova directory ---

(claim Dir Type)
(define Dir Directory)

(claim empty Dir)
(define empty Query.directory)

(claim with-file (→ Dir Abs String Dir))        ; rw-r--r--, 0644
(define (with-file d path contents) (Directory.with-new-file d path contents 420))

(claim with-executable (→ Dir Abs String Dir))  ; rwxr-xr-x, 0755: uno script
(define (with-executable d path contents) (Directory.with-new-file d path contents 493))

(claim without (→ Dir Abs Dir))
(define (without d path) (Directory.without-file d path))

(claim sub (→ Dir Abs Dir))
(define (sub d path) (Directory.directory d path))

(claim put (→ Dir Abs Dir Dir))
(define (put d path source) (Directory.with-directory d path source))

(claim exists? (→ Dir Abs (Remote Bool)))
(define (exists? d path) (Directory.exists d path))

; --- container: with-exec dichiara un comando, non lo esegue ---
; I campi dello schema si scrivono senza prefisso: (from c "alpine") è Container.from perché c è
; un Container, (container) è il campo radice Query.container. Qui solo i nomi curati.

(claim with-dir (→ Container Abs Dir Container))
(define (with-dir c path source) (Container.with-directory c path source))

(claim with-env (→ Container String String Container))
(define (with-env c name value) (Container.with-env-variable c name value))

(claim dir-of (→ Container Abs Dir))
(define (dir-of c path) (Container.directory c path))

; Un valore di configurazione, in chiaro o segreto: l'host di un servizio a volte sta in un
; segreto. Nel container diventa una variabile d'ambiente in entrambi i casi.
(data Setting
  (public String)
  (private Secret))

; Una build da Dockerfile: i segreti arrivano per nome (RUN --mount=type=secret,id=ssh-key).
; Il valore di un segreto non entra nella chiave di cache di BuildKit: un RUN che lo copia in un
; file resta in cache anche se il segreto cambia. Un argomento che il Dockerfile dichiara prima di
; quel RUN, e che cambia (una versione), lo fa rieseguire.
(claim build-dockerfile (→ Dir String (List Build-arg) (List Secret) Container))   ; sorgente, Dockerfile, argomenti, segreti
(define (build-dockerfile src dockerfile args secrets) (Directory.docker-build src dockerfile args secrets))

(claim with-setting (→ Container String Setting Container))
(define (with-setting c name n)
  (match n
    ((public s)  (with-env c name s))
    ((private s) (Container.with-secret-variable c name s))))

; --- proprietà del piano: si calcolano sul dato ---

(claim image-of (→ Any (List Image)))
(define (image-of n)
  (match n
    ((any (Container.from _ address)) (list address))
    (_                                (list))))

(claim images (→ (Obj k) (List Image)))
(define (images p) (concat-map image-of (nodes p)))

; Un'immagine con tag è un punto mobile, una con digest un punto fisso: pinned vuol dire fissa.
(claim pinned? (→ Image Bool))
(define (pinned? i) (contains? (Image.raw i) "@sha256:"))

; Proprietà d'ordine. Un piano, seguito per ogni esito dei branch, è una storia: osservazioni
; vere (seen) e uscite realizzate (done), nell'ordine in cui avvengono; then concatena, branch
; sceglie. Non si scende nelle directory, quindi le proprietà valgono anche per un input astratto:
; (Π ((src Dir)) (Before … (release src))). Un'osservazione nella storia dice che quel test ha
; risposto sì in quel momento: è la verità di quel test, non del mondo, e non diventa un assioma.

(data Event
  (seen (Remote Bool))
  (done (Export Dir)))

(claim histories (→ (Export Dir) (List (List Event))))
(define (histories n)
  (match n
    ((branch c a b) (++ (map (:: (seen c)) (histories a)) (histories b)))
    ((then a b)     (concat-map (λ (h) (map (++ h) (histories b))) (histories a)))
    (skip           (list (list)))
    ((otherwise a b) (++ (histories a) (histories b)))   ; b dopo un fallimento di a: il caso peggiore, b da solo
    (e              (list (list (done e))))))

; (earlier w? e? g h): in h, ogni uscita che soddisfa e? viene dopo un evento che soddisfa w?.
(claim allowed? (→ (→ (Export Dir) Bool) Bool Event Bool))
(define (allowed? e? g n)
  (match n
    ((seen _) true)
    ((done x) (if (e? x) g true))))

(claim earlier (→ (→ Event Bool) (→ (Export Dir) Bool) Bool (List Event) Bool))
(define (earlier w? e? g n)
  (match n
    (vuota     true)
    ((:: x xs) (and (allowed? e? g x) (earlier w? e? (or g (w? x)) xs)))))

(claim seen? (→ (→ (Remote Bool) Bool) Event Bool))
(define (seen? t? n)
  (match n
    ((seen c) (t? c))
    ((done _) false)))

(claim done? (→ (→ (Export Dir) Bool) Event Bool))
(define (done? s? n)
  (match n
    ((done x) (s? x))
    ((seen _) false)))

; (Before t? e? p): ogni uscita che soddisfa e? avviene dopo un'osservazione vera che soddisfa t?.
(claim Before (→ (→ (Remote Bool) Bool) (→ (Export Dir) Bool) (Export Dir) Type))
(define (Before t? e? p) (So (all (earlier (seen? t?) e? false) (histories p))))

; (Precedes s? e? p): ogni uscita che soddisfa e? avviene dopo un'uscita che soddisfa s?.
(claim Precedes (→ (→ (Export Dir) Bool) (→ (Export Dir) Bool) (Export Dir) Type))
(define (Precedes s? e? p) (So (all (earlier (done? s?) e? false) (histories p))))

(claim test? (→ (Remote Bool) Bool))        ; un test, nel container o sul mondo
(define (test? n)
  (match n
    ((passes? _) true)
    ((probe _ _) true)
    (_           false)))

(claim publish? (→ (Export Dir) Bool))
(define (publish? n)
  (match n
    ((publish _ _) true)
    (_             false)))

(claim apply? (→ (Export Dir) Bool))
(define (apply? n)
  (match n
    ((apply _ _) true)
    (_           false)))

; Montaggi lungo la catena di un container: dove vengono collocati directory, file e cache.
; Due container diversi non si contendono il file system, quindi si guarda solo la catena (chain),
; che non scende negli argomenti: la proprietà vale per ogni sorgente.

(claim mount-of (→ Any (List Abs)))
(define (mount-of n)
  (match n
    ((any (Container.with-directory _ path _))         (list path))
    ((any (Container.with-file _ path _))              (list path))
    ((any (Container.with-mounted-directory _ path _)) (list path))
    ((any (Container.with-mounted-file _ path _))      (list path))
    ((any (Container.with-mounted-cache _ path _))     (list path))
    (_                                                 (list))))

(claim mounts (→ (Obj k) (List Abs)))
(define (mounts p) (concat-map mount-of (chain p)))

(claim Disjoint-mounts (→ (Obj k) Type))
(define (Disjoint-mounts p) (Pairwise ⋔ (mounts p)))

; Porte esposte lungo la catena di un container: nessuna porta allocata due volte.

(claim port-of (→ Any (List Port)))
(define (port-of n)
  (match n
    ((any (Container.with-exposed-port _ p)) (list p))
    (_                                       (list))))

(claim ports (→ (Obj k) (List Port)))
(define (ports p) (concat-map port-of (chain p)))

(claim Distinct-ports (→ (Obj k) Type))
(define (Distinct-ports p) (Pairwise port≠ (ports p)))
