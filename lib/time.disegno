(import affine)

; --- tempo: istanti e durate, in secondi. "2026-10-15T10:00:00Z" è un istante, "1h30m" una durata ---

(data Instant
  (at Nat))
(builtin instant Instant)

(data Duration
  (secs Nat))
(builtin duration Duration)

(claim Instant.⊕ (→ Instant Duration Instant))
(define (Instant.⊕ n m)
  (match* (n m)
    (((at a) (secs d)) (at (+ a d)))))

; Sugli istanti (miliardi di secondi) l'ordine è il test decidibile, che auto calcola; la legge
; passa per la relazione induttiva con il lemma di riflessione ≤-from.
(claim ≥t (→ Instant Instant Type))        ; (≥t p q): p non viene prima di q
(define (≥t n m)
  (match* (n m)
    (((at p) (at q)) (So (≤? q p)))))

(claim Instant.⊖ (Π ((p Instant) (q Instant)) (→ (≥t p q) Duration)))
(define (Instant.⊖ p q _)
  (match* (p q)
    (((at a) (at b)) (secs (∸ a b)))))

(claim Instant.⊕-⊖ (Π ((p Instant) (q Instant) (h (≥t p q))) (≡ (Instant.⊕ q (Instant.⊖ p q h)) p)))
(define (Instant.⊕-⊖ p q h)
  (match* (p q)
    (((at a) (at b)) (cong at (+-∸ a b (≤-from b a h))))))

(claim tempo (Affine Instant Duration ≥t))
(define tempo (affine Instant.⊕ Instant.⊖ Instant.⊕-⊖))

(claim window (→ Instant Duration Interval)) ; una finestra: dall'istante, per la durata
(define (window n m)
  (match* (n m)
    (((at a) (secs d)) (interval a (+ a d)))))
