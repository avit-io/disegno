; Spazi affini e regioni su una retta: la struttura comune a percorsi, tempo e indirizzi.

; Uno spazio affine: punti P, spostamenti V, una relazione ≤ che dice quando la differenza esiste.
(record (Affine P V (≤ (→ P P Type)))
  (+ (→ P V P))
  (- (Π ((p P) (q P)) (→ (≤ p q) V)))
  (law (Π ((p P) (q P) (h (≤ p q))) (≡ (+ q (- p q h)) p))))

; --- naturali: l'istanza da cui discendono tempo e indirizzi ---

(claim ≥N (→ Nat Nat Type))                ; (≥N p q): la differenza p ∸ q è esatta
(define (≥N p q) (≤ q p))

(claim Nat.⊖ (Π ((p Nat) (q Nat)) (→ (≥N p q) Nat)))
(define (Nat.⊖ p q _) (∸ p q))

(claim naturali (Affine Nat Nat ≥N))
(define naturali (affine + Nat.⊖ +-∸))

; --- regioni su una retta: intervalli semiaperti [lo, hi) ---
; Le finestre di tempo, i blocchi CIDR e gli intervalli di porte sono intervalli; le proposizioni
; naturali sono il contenimento e la disgiunzione.

(record Interval
  (lo Nat)
  (hi Nat))

(claim apart? (→ Interval Interval Bool))
(define (apart? a b) (or (≤? (Interval.hi a) (Interval.lo b)) (≤? (Interval.hi b) (Interval.lo a))))

(data Apart : (→ Interval Interval Type)
  (apart : (Π ((a Interval) (b Interval)) (→ (So (apart? a b)) (Apart a b)))))

(claim within? (→ Interval Interval Bool))  ; a sta dentro b
(define (within? a b) (and (≤? (Interval.lo b) (Interval.lo a)) (≤? (Interval.hi a) (Interval.hi b))))

(claim Within (→ Interval Interval Type))
(define (Within a b) (So (within? a b)))
