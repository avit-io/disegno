; Un banale go build: il sorgente dall'host, la compilazione in un container, il binario sull'host.
; I percorsi sono punti: bin è derivato da out, quindi (⊑ bin out) vale per costruzione.

(def go-build : (→ Dir Dir)
  [src] (let [root /src, out /out, bin (/ out "hello")]
          (pipe (container)
                (from "golang:1.25-alpine")
                (with-mounted-cache /go/pkg/mod (cache-volume "go-mod"))
                (with-env "CGO_ENABLED" "0")
                (with-dir root src)
                (with-workdir root)
                (with-exec ["go" "build" "-o" bin "."])
                (dir-of out))))

(def main : (→ [src (Host "hello")] (Export Dir))
  [src] (overlay "bin" (go-build src)))

(def binario-dentro-out : (⊑ (/ /out "hello") /out)
  auto)
