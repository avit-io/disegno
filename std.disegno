; Libreria standard: l'unico posto dove extern è ammesso.

; --- uguaglianza ---

(data ≡ : (→ A A Type)
  [refl : (≡ x x)])

(def cong : (→ [f (→ A B)] (≡ x y) (≡ (f x) (f y)))
  [f refl] refl)

(def sym : (→ (≡ x y) (≡ y x))
  [refl] refl)

; --- liste: ["a" "b"] è zucchero per (:: "a" (:: "b" vuota)) ---

(data List : (→ Type Type)
  [vuota : (List A)]
  [::    : (→ A (List A) (List A))])

; --- tipi opachi del motore ---

(extern String    : Type String)
(extern Dir       : Type Directory)
(extern Container : Type Container)

; --- file system del motore: valori immutabili, scrivere è costruire una nuova directory ---

(extern empty     : Dir                                                directory)
(extern with-file : (→ [dir Dir] [path String] [contents String] Dir) Directory.withNewFile)
(extern without   : (→ [dir Dir] [path String] Dir)                    Directory.withoutFile)
(extern sub       : (→ [dir Dir] [path String] Dir)                    Directory.directory)
(extern put       : (→ [dir Dir] [path String] [source Dir] Dir)       Directory.withDirectory)

; --- container: anch'essi valori immutabili; with-exec dichiara un comando, non lo esegue ---

(extern container    : Container                                                     container)
(extern from         : (→ [ctr Container] [address String] Container)                 Container.from)
(extern with-exec    : (→ [ctr Container] [args (List String)] Container)             Container.withExec)
(extern with-dir     : (→ [ctr Container] [path String] [source Dir] Container)       Container.withDirectory)
(extern with-workdir : (→ [ctr Container] [path String] Container)                    Container.withWorkdir)
(extern with-env     : (→ [ctr Container] [name String] [value String] Container)     Container.withEnvVariable)
(extern dir-of       : (→ [ctr Container] [path String] Dir)                          Container.directory)

; --- confine con l'host: il programma dichiara cosa riceve e cosa restituisce ---
; %host-dir è riservato: l'utente legge l'host solo tramite (Host "percorso") nella firma di main.

(extern %host-dir : (→ [path String] Dir) host.directory)

(def Host : (→ String Type)
  [path] Dir)

(data Export : (→ Type Type)
  [overlay : (→ String A (Export A))]
  [replace : (→ String A (Export A))])

; --- due tempi, due condizionali ---
; if decide su valori noti quando si costruisce il piano; branch su osservazioni Remote, che
; esistono solo durante l'esecuzione. Un (Remote Bool) non è un Bool: non entra in un if.

(data Bool
  [true]
  [false])

(def if : (→ Bool A A A)
  [true  a _] a
  [false _ b] b)

(extern Remote   : (→ Type Type)                                            %remote)
(extern try-exec : (→ [ctr Container] [args (List String)] Container)      (Container.withExec (expect ANY)))
(extern passes?  : (→ [ctr Container] (Remote Bool))                        Container.exitCode)
(extern exists?  : (→ [dir Dir] [path String] (Remote Bool))                Directory.exists)
(extern branch   : (→ (Remote Bool) A A A)                                  %branch)
