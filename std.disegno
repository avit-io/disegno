; Libreria standard: l'unico posto dove extern è ammesso.

; --- uguaglianza ---

(data ≡ : (→ A A Type)
  [refl : (≡ x x)])

(def cong : (→ [f (→ A B)] (≡ x y) (≡ (f x) (f y)))
  [f refl] refl)

(def sym : (→ (≡ x y) (≡ y x))
  [refl] refl)

; --- proposizioni decidibili: (So b) è ⊤ se b è vero, ⊥ altrimenti; auto prova ⊤ calcolando ---

(data ⊥ : Type)

(data ⊤
  [tt])

(data Bool
  [true]
  [false])

(def So : (→ Bool Type)
  [true]  ⊤
  [false] ⊥)

(def if : (→ Bool A A A)
  [true  a _] a
  [false _ b] b)

; --- naturali: 0, 1, 2… sono zucchero per zero, add1 ---

(data Nat
  [zero]
  [add1 Nat])

(def + : (→ Nat Nat Nat)
  [zero     m] m
  [(add1 k) m] (add1 (+ k m)))

(def ≤? : (→ Nat Nat Bool)
  [zero     _]        true
  [(add1 _) zero]     false
  [(add1 m) (add1 n)] (≤? m n))

(def ≥ : (→ Nat Nat Type)
  [m n] (So (≤? n m)))

; --- liste: ["a" "b"] è zucchero per (:: "a" (:: "b" vuota)) ---

(data List : (→ Type Type)
  [vuota : (List A)]
  [::    : (→ A (List A) (List A))])

; --- il motore: tipi ed extern generati dallo schema (gen.ss) ---

(extern String : Type String)
(extern Remote : (→ Type Type) %remote)   ; osservazioni: esistono solo durante l'esecuzione

(include "engine.disegno")

; --- nomi corti: file system del motore, valori immutabili; scrivere è costruire una nuova directory ---

(def Dir : Type
  Directory)

(def empty : Dir
  Query.directory)

(def with-file : (→ Dir String String Dir)
  [d path contents] (Directory.with-new-file d path contents))

(def without : (→ Dir String Dir)
  [d path] (Directory.without-file d path))

(def sub : (→ Dir String Dir)
  [d path] (Directory.directory d path))

(def put : (→ Dir String Dir Dir)
  [d path source] (Directory.with-directory d path source))

; --- container: anch'essi valori immutabili; with-exec dichiara un comando, non lo esegue ---

(def container : Container
  Query.container)

(def from : (→ Container String Container)
  [c address] (Container.from c address))

(def with-exec : (→ Container (List String) Container)
  [c args] (Container.with-exec c args))

(def with-dir : (→ Container String Dir Container)
  [c path source] (Container.with-directory c path source))

(def with-workdir : (→ Container String Container)
  [c path] (Container.with-workdir c path))

(def with-env : (→ Container String String Container)
  [c name value] (Container.with-env-variable c name value))

(def dir-of : (→ Container String Dir)
  [c path] (Container.directory c path))

; --- confine con l'host: il programma dichiara cosa riceve e cosa restituisce ---
; %host-dir è riservato: l'utente legge l'host solo tramite (Host "percorso") nella firma di main.

(extern %host-dir : (→ [path String] Directory) host.directory)

(def Host : (→ String Type)
  [path] Dir)

(data Export : (→ Type Type)
  [overlay : (→ String A (Export A))]
  [replace : (→ String A (Export A))])

; --- due tempi, due condizionali ---
; if (sopra) decide su valori noti quando si costruisce il piano; branch su osservazioni Remote,
; che esistono solo durante l'esecuzione. Un (Remote Bool) non è un Bool: non entra in un if.

(extern try-exec : (→ [ctr Container] [args (List String)] Container) (Container.withExec (expect ANY)))
(extern passes?  : (→ [ctr Container] (Remote Bool))                   Container.exitCode)
(extern branch   : (→ (Remote Bool) A A A)                             %branch)

(def exists? : (→ Dir String (Remote Bool))
  [d path] (Directory.exists d path))
