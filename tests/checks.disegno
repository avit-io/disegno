; Controlli: proprietà della libreria standard e dei piani, scritte come teoremi.
; Il type checker le verifica a ogni esecuzione dei test (test.ss): se una modifica rompe una
; legge, un letterale o una garanzia sui piani, questo file smette di compilare.
; Le leggi generali si dimostrano per induzione; i casi concreti li calcola auto.

; --- aritmetica e liste ---

(def +-assoc : (→ [a Nat] [b Nat] [c Nat] (≡ (+ (+ a b) c) (+ a (+ b c))))
  [zero     b c] refl
  [(add1 a) b c] (cong add1 (+-assoc a b c)))

(def ++-vuota : (→ [xs (List A)] (≡ (++ xs vuota) xs))
  [vuota]     refl
  [(:: x xs)] (cong (:: x) (++-vuota xs)))

(def ++-assoc : (→ [xs (List A)] [ys (List A)] [zs (List A)] (≡ (++ (++ xs ys) zs) (++ xs (++ ys zs))))
  [vuota     ys zs] refl
  [(:: x xs) ys zs] (cong (:: x) (++-assoc xs ys zs)))

; --- percorsi: lo spazio affine ---

(def ⊑-trans : (→ (⊑ p q) (⊑ q r) (⊑ p r))
  [⊑-refl     h] h
  [(⊑-step g) h] (⊑-step (⊑-trans g h)))

(def ⊕-here : (→ [p Abs] (≡ (⊕ p here) p))
  [p] refl)

(def legge : (→ [p Abs] [q Abs] [h (⊑ p q)] (≡ (⊕ q (⊖ p q h)) p))
  [p q h] (Affine.law percorsi p q h))

(def ⊖-ritorno : (≡ (⊖ /out/bin/hello /out auto) "bin/hello")
  auto)

(def separati : (⋔ /src /go/pkg/mod)
  auto)

; --- letterali: il letterale resta, il tipo cambia ---

(def letterale-immagine : (≡ (Image.raw "golang:1.25-alpine") "golang:1.25-alpine")
  auto)

(def letterale-punto : (≡ /go/pkg/mod (/ (/ (/ root "go") "pkg") "mod"))
  auto)

(def letterale-vettore : (≡ (⊕ /out "bin/hello") /out/bin/hello)
  auto)

; --- piani: le garanzie che oggi stanno in linter e policy ---

(def piano-pinnato : (All pinned? (images (pipe (container) (from "alpine@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1"))))
  auto)

(def immagini-in-ordine : (≡ (images (pipe (container) (from "a") (with-dir /w (dir-of (from (container) "b") root)))) ["a" "b"])
  auto)

(def publish-protetto : (→ [src Dir] (Before test? publish?
                                       (branch (passes? (try-exec (with-dir (from (container) "alpine") /src src) ["make" "test"]))
                                         (publish (with-dir (from (container) "alpine") /app src) "registry.example.com/app:1")
                                         (overlay "report" src))))
  [src] auto)

(def montaggi : (→ [src Dir] (Disjoint-mounts (pipe (container) (with-dir /src src) (with-mounted-cache /cache (cache-volume "c")))))
  [src] auto)

(def montaggi-visti : (≡ (mounts (pipe (container) (with-dir /src empty) (with-mounted-cache /cache (cache-volume "c"))))
                         [/cache /src])
  auto)

; --- negazioni: ciò che non deve valere, come teorema ---
; Un pattern assurdo () dichiara che a quella posizione non c'è alcun valore; la clausola non ha
; corpo. Per avere (⊑ /out /src) servirebbe ⊑-step su una prova di (⊑ root /src): impossibile.

(def fuori-a-mano : (¬ (⊑ /out /src))
  [(⊑-step ())])

(def fuori : (¬ (⊑ /out /src))
  auto)

(def non-pinnata : (¬ (All pinned? (images (from (container) "alpine"))))
  auto)

(def annidati-non-disgiunti : (¬ (⋔ /src /src/cache))
  auto)

(def montaggi-sovrapposti : (¬ (Disjoint-mounts (pipe (container) (with-dir /src empty) (with-mounted-cache /src/cache (cache-volume "c")))))
  auto)

(def zero-non-è-uno : (¬ (≡ 0 1))
  [()])

; --- naturali e accelerazione: la legge vale anche sui numeri grandi, calcolati nativamente ---

(def legge-naturali : (≡ (+ 1000000 (∸ 4294967296 1000000)) 4294967296)
  auto)

; --- tempo: istanti e durate ---

(def inizio : Instant "2026-10-15T00:00:00Z")
(def fine   : Instant "2026-10-16T00:00:00Z")

(def un-giorno-dopo : (≡ (⊕ inizio "1d") fine)
  auto)

(def durata : (≡ (⊖ fine inizio auto) "24h")
  auto)

(def finestre-separate : (Apart (window inizio "1h") (window fine "1h"))
  auto)

(def finestre-sovrapposte : (¬ (Apart (window inizio "2h") (window (⊕ inizio "1h") "1h")))
  auto)

; --- indirizzi: punti raffinati e blocchi CIDR come regioni ---

(def gateway : Ip "10.0.0.1")

(def indirizzo-dopo : (≡ (⊕ gateway 1 auto) "10.0.0.2")
  auto)

(def dentro-il-blocco : (So (in? "10.0.0.5" "10.0.0.0/24"))
  auto)

(def subnet-disgiunte : (Disjoint-subnets ["10.0.0.0/24" "10.0.1.0/24" "10.1.0.0/16"])
  auto)

(def subnet-annidate : (¬ (Disjoint-subnets ["10.0.0.0/8" "10.1.0.0/16"]))
  auto)

; --- porte: nessuna porta allocata due volte ---

(def porte-distinte : (Distinct-ports (pipe (container) (with-exposed-port 8080) (with-exposed-port 9090)))
  auto)

(def porte-doppie : (¬ (Distinct-ports (pipe (container) (with-exposed-port 8080) (with-exposed-port 8080))))
  auto)

; --- stringhe: il letterale si compone, il calcolo avviene sui letterali ---

(def resa : (≡ (concat "porta = " (show 8080)) "porta = 8080")
  auto)

(def resa-cidr : (≡ (render-cidr "10.0.1.0/24") "10.0.1.0/24")
  auto)

; --- il linguaggio puro: λ, the, impliciti, Σ, Either, transport, ex falso ---

(def id : (→ {A Type} A A)
  (λ [x] x))

(def applica : (≡ ((the (→ Nat Nat) (λ [n] (add1 n))) 1) 2)
  auto)

(def un-testimone : (Σ Nat (λ [n] (≡ (+ n n) 4)))
  (pair 2 refl))

(def il-testimone : (≡ (fst un-testimone) 2)
  auto)

(def ex-falso : (→ ⊥ A)
  [()])

(def sposta : (→ (≡ x y) (≡ y y) (≡ x y))
  [e p] (transport (sym e) (λ [m] (≡ m y)) p))

(def nomi-come-variabili : (→ Nat (→ Nat Nat) Nat)   ; step e port sono costruttori altrove
  [port step] (step port))
