; Soluzioni del capitolo 2 — Eliminare con armonia
;
;   disegno check book/solutions/02-eliminations.disegno

(data Stagione
  (primavera)
  (estate)
  (autunno)
  (inverno))

(claim successiva (→ Stagione Stagione))
(define (successiva n)
  (match n
    (primavera estate)
    (estate    autunno)
    (autunno   inverno)
    (inverno   primavera)))

(claim somma (→ Nat Nat Nat))
(define (somma n m)
  (match n
    (zero m)
    ((add1 k) (add1 (somma k m)))))

; 1. Un caso per ogni introduzione, come successiva ma all'indietro.

(claim precedente (→ Stagione Stagione))
(define (precedente n)
  (match n
    (primavera inverno)
    (estate    primavera)
    (autunno   estate)
    (inverno   autunno)))

(claim avanti-e-indietro (≡ (precedente (successiva estate)) estate))
(define avanti-e-indietro auto)

; 2. Il pattern _ risponde a tutte le introduzioni rimaste: la copertura è comunque completa.

(claim inverno? (→ Stagione Bool))
(define (inverno? n)
  (match n
    (inverno true)
    (_       false)))

; 3. La ricorsione su k, come in somma: il caso (add1 k) usa il risultato su k.

(claim prodotto (→ Nat Nat Nat))
(define (prodotto n m)
  (match n
    (zero zero)
    ((add1 k) (somma m (prodotto k m)))))

(claim sei (≡ (prodotto 2 3) 6))
(define sei auto)
